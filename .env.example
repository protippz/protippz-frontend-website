# Copy to .env and fill in. Never commit real values.

# --- URLs (optional – defaults shown) ---
NEXT_PUBLIC_API_BASE_URL=https://api.protippz.com
NEXT_PUBLIC_SITE_URL=https://www.protippz.com

# --- Auth / third parties ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=
NEXT_PUBLIC_CHATBOT_SCRIPT=

# --- Analytics / SEO ---
NEXT_PUBLIC_GOOGLE_ANALYTICS=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Server-only secrets ---
# Google Places key used by /api/places. Prefer this server-only name;
# NEXT_PUBLIC_ADDRESS_API_KEY is still read as a fallback but exposes nothing extra.
ADDRESS_API_KEY=

# --- Geo / maintenance switches (src/proxy.ts) ---
ALLOW_BD_ACCESS=false
SHOW_UNDER_DEVELOPMENT=false
